{
	"name": "@hexpro/qr-code-studio",
	"version": "0.0.0",
	"description": "Make, design, check and read QR codes entirely in the browser, with no server, no upload and no runtime dependencies",
	"keywords": [
		"qr",
		"qr code",
		"qrcode",
		"micro qr",
		"rmqr",
		"generator",
		"scanner",
		"svg",
		"pdf",
		"offline",
		"browser"
	],
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./core": {
			"types": "./dist/core/index.d.ts",
			"import": "./dist/core/index.js"
		},
		"./payload": {
			"types": "./dist/payload/index.d.ts",
			"import": "./dist/payload/index.js"
		},
		"./own-link": {
			"types": "./dist/own-link/index.d.ts",
			"import": "./dist/own-link/index.js"
		},
		"./geometry": {
			"types": "./dist/geometry/index.d.ts",
			"import": "./dist/geometry/index.js"
		},
		"./render": {
			"types": "./dist/render/index.d.ts",
			"import": "./dist/render/index.js"
		},
		"./segment": {
			"types": "./dist/segment/index.d.ts",
			"import": "./dist/segment/index.js"
		},
		"./symbology": {
			"types": "./dist/symbology/index.d.ts",
			"import": "./dist/symbology/index.js"
		},
		"./encode": {
			"types": "./dist/encode/index.d.ts",
			"import": "./dist/encode/index.js"
		},
		"./design": {
			"types": "./dist/design/index.d.ts",
			"import": "./dist/design/index.js"
		},
		"./conformance": {
			"types": "./dist/conformance/index.d.ts",
			"import": "./dist/conformance/index.js"
		},
		"./decode": {
			"types": "./dist/decode/index.d.ts",
			"import": "./dist/decode/index.js"
		},
		"./text": {
			"types": "./dist/text/index.d.ts",
			"import": "./dist/text/index.js"
		},
		"./verify": {
			"types": "./dist/verify/index.d.ts",
			"import": "./dist/verify/index.js"
		},
		"./inspect": {
			"types": "./dist/inspect/index.d.ts",
			"import": "./dist/inspect/index.js"
		},
		"./fonts/latin": {
			"types": "./dist/fonts/latin.d.ts",
			"import": "./dist/fonts/latin.js"
		},
		"./standalone.html": "./dist/qr-code-studio.html"
	},
	"files": [
		"dist",
		"package.json",
		"LICENSE",
		"README.md",
		"CHANGELOG.md"
	],
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hexpro-dev/qr-code-studio.git"
	},
	"homepage": "https://github.com/hexpro-dev/qr-code-studio#readme",
	"bugs": {
		"url": "https://github.com/hexpro-dev/qr-code-studio/issues"
	},
	"packageManager": "pnpm@10.33.0",
	"scripts": {
		"build": "tsc",
		"build:html": "tsx scripts/build-html.ts",
		"build:all": "pnpm run build && pnpm run build:html",
		"build:fonts": "tsx scripts/build-fonts.ts",
		"clean": "rimraf dist coverage",
		"typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"prepublishOnly": "pnpm run clean && pnpm run build:all && pnpm run typecheck && pnpm run test"
	},
	"dependencies": {},
	"devDependencies": {
		"@eslint/js": "^9.17.0",
		"@playwright/test": "1.63.0",
		"@resvg/resvg-js": "^2.6.2",
		"@types/node": "^22.10.2",
		"@types/pngjs": "^6.0.5",
		"@types/qrcode": "^1.5.6",
		"@types/yauzl": "^3.4.0",
		"@vitest/coverage-v8": "^2.1.8",
		"@xmldom/xmldom": "^0.9.12",
		"bwip-js": "^4.11.4",
		"esbuild": "^0.24.0",
		"eslint": "^9.17.0",
		"fake-indexeddb": "^6.2.6",
		"fast-check": "^4.10.2",
		"iconv-lite": "^0.7.3",
		"jsqr": "^1.4.0",
		"opentype.js": "^2.0.0",
		"pngjs": "^7.0.0",
		"prettier": "^3.4.2",
		"qrcode": "1.5.4",
		"qrcode-generator": "^2.0.4",
		"rimraf": "^6.0.1",
		"tsx": "^4.19.2",
		"typescript": "^5.7.2",
		"typescript-eslint": "^8.18.2",
		"vitest": "^2.1.8",
		"yauzl": "^3.4.0",
		"zxing-wasm": "^3.1.6"
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"license": "MIT",
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	}
}
